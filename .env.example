# Application Environment
NODE_ENV=development

# Backend Service Configuration
PORT=4000
BACKEND_INTERNAL_URL=http://localhost:4000

# PostgreSQL Database Configuration
POSTGRES_USER=stockwatch
POSTGRES_PASSWORD=stockwatch_secure_password
POSTGRES_DB=stockwatch
DATABASE_URL=postgresql://stockwatch:stockwatch_secure_password@localhost:5432/stockwatch?schema=public

# Redis & Queue Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Worker Settings
WORKER_SIMULATE_FAILURE=false


# Least-privilege database identities (see docs/database-roles.md).
# Runtime (backend + worker) should use stockwatch_app via DATABASE_URL; schema
# migrations in deploy.sh use MIGRATION_DATABASE_URL (stockwatch_migrator) and
# fall back to DATABASE_URL when unset.
# MIGRATION_DATABASE_URL=postgresql://stockwatch_migrator:<password>@<host>:5432/stockwatch?schema=public

# Local docker-compose only: let the backend create the schema at startup (never in production).
# DB_BOOTSTRAP_SCHEMA=true

# PostgreSQL-backed queue recovery (backend). 0 disables the periodic pass.
# STOCK_CHECK_RECOVERY_INTERVAL_MS=60000
# STOCK_CHECK_RECOVERY_STALE_AFTER_MS=120000

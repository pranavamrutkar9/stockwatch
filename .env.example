# Application Environment
NODE_ENV=development

# Backend Service Configuration
PORT=4000
BACKEND_INTERNAL_URL=http://localhost:4000

# PostgreSQL Database Configuration
POSTGRES_USER=stockwatch
POSTGRES_PASSWORD=stockwatch_secure_password
POSTGRES_DB=stockwatch
DATABASE_URL=postgresql://stockwatch:stockwatch_secure_password@localhost:5432/stockwatch?schema=public

# Redis & Queue Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Worker Settings
WORKER_SIMULATE_FAILURE=false

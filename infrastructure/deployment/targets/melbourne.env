# StockWatch deployment target: DR (Melbourne). Non-secret; committed.
# NOT PROVISIONED. The endpoint suffix is account/region specific and only known after the
# replica exists; deploy.sh/rollback.sh refuse to run while a placeholder (<...>) remains.
STOCKWATCH_REGION=ap-southeast-4
RDS_EXPECTED_HOST=stockwatch-dr-replica.<endpoint-suffix>.ap-southeast-4.rds.amazonaws.com
RDS_DATABASE_NAME=stockwatch
RDS_CA_BUNDLE_FILE=ap-southeast-4-bundle.pem
RDS_CA_BUNDLE_HOST_PATH=/home/ubuntu/ap-southeast-4-bundle.pem

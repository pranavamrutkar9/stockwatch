{
  "name": "stockwatch",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.5.0",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm --filter @stockwatch/frontend lint",
    "db:generate": "pnpm --filter @stockwatch/database generate",
    "db:build": "pnpm --filter @stockwatch/database build"
  }
}

# Dependencies
node_modules/
.pnpm-store/

# Build outputs and caches
dist/
build/
.next/
out/
.turbo/
*.tsbuildinfo

# Environment and secrets
.env
.env.local
.env.*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS and Editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Local data / Docker volumes
pgdata/

# Runtime deployment state and sensitive backups
.env.*
!.env.example
infrastructure/deployment/.current_tag
infrastructure/deployment/.previous_tag
*.pre-rds
*.pre-rds-final
*.pre-regional-ca
*.dump
/d

# Deployment locks, temporary state and local recovery backups
infrastructure/deployment/.deployment.lock
infrastructure/deployment/.*.tmp
infrastructure/deployment/*.pre-auto-rollback
infrastructure/deployment/*.pre-hardening
infrastructure/docker/*.save

# Terraform: never commit state, plans, local variable files or provider caches
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
terraform.tfvars
*.auto.tfvars
